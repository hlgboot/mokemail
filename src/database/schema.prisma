
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Newsletters {
  id Int @default(autoincrement()) @id
  name String? @unique
  email String? @unique
  tag Tags
}

model Users {
  id Int @default(autoincrement()) @id
  email String? @unique
  tags Tags[]
}
model Tags {
  id Int @default(autoincrement()) @id
  name String? @unique
}